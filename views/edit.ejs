<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Item</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="update">
    <form action="/items/<%=item.id%>?_method=patch" method="post" class="form">
        <h2 class="h">Name: <%=item.name %></h2>
        <b><label for="location">Location: </label></b>
        <input value="<%=item.location%>" name="location" class="input">
        <br><br>
        <b><label for="Description" >Description:</label></b>
        <textarea name="description"><%=item.description%></textarea>
        <br><br>
        <b><label for="contact">contact</label></b>
        <input value="<%=item.contact%>" name="contact" class="input">
        <br><br>
        <button type="submit">Update Changes</button>
        
    </form>
    </div>

</body>
</html>